{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Edit|Write",
        "bash": "bash ./scripts/hooks/protect-config.sh",
        "powershell": "& .\\scripts\\hooks\\protect-config.ps1",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
